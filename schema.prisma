  organization   Organization @relation("IntegrationCredential_organization", fields: [organizationId], references: [id])
  organizationId String       @map("organization")
  label          String       @default("")
  digest         String       @unique @default("")
  scopes         Json?        @default("[]")
  partner        String       @default("")
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdBy      String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([organizationId])
}

model Organization {
  id                                      String                     @id @default(cuid())
  name                                    String                     @default("")
  slug                                    String                     @unique @default("")
  status                                  OrganizationStatusType     @default(active)
  defaultCurrency                         String                     @default("USD")
  timezone                                String                     @default("America/Los_Angeles")
  isMultiLocation                         Boolean                    @default(true)
  users                                   User[]                     @relation("User_organization")
  roles                                   Role[]                     @relation("Role_organization")
  members                                 Member[]                   @relation("Member_organization")
  instructors                             Instructor[]               @relation("Instructor_organization")
  locations                               Location[]                 @relation("Location_organization")
  resources                               Room[]                     @relation("Room_organization")
  instructorAvailability                  InstructorAvailability[]   @relation("InstructorAvailability_organization")
  appointments                            Appointment[]              @relation("Appointment_organization")
  membershipTiers                         MembershipTier[]           @relation("MembershipTier_organization")
  memberships                             Membership[]               @relation("Membership_organization")
  membershipPayments                      MembershipPayment[]        @relation("MembershipPayment_organization")
  subscriptions                           Subscription[]             @relation("Subscription_organization")
  payments                                Payment[]                  @relation("Payment_organization")
  paymentMethods                          PaymentMethod[]            @relation("PaymentMethod_organization")
  paymentProviders                        PaymentProvider[]          @relation("PaymentProvider_organization")
  paymentSessions                         PaymentSession[]           @relation("PaymentSession_organization")
  paymentEvents                           PaymentEvent[]             @relation("PaymentEvent_organization")
  checkIns                                CheckIn[]                  @relation("CheckIn_organization")
  attendanceRecords                       AttendanceRecord[]         @relation("AttendanceRecord_organization")
  classTypes                              ClassType[]                @relation("ClassType_organization")
  classSchedules                          ClassSchedule[]            @relation("ClassSchedule_organization")
  classBookings                           ClassBooking[]             @relation("ClassBooking_organization")
  classInstances                          ClassInstance[]            @relation("ClassInstance_organization")
  studioSettings                          StudioSettings[]           @relation("StudioSettings_organization")
  onboardingRuns                          OnboardingRun[]            @relation("OnboardingRun_organization")
  refundAttempts                          RefundAttempt[]            @relation("RefundAttempt_organization")
  membershipBillingAttempts               MembershipBillingAttempt[] @relation("MembershipBillingAttempt_organization")
  createdAt                               DateTime                   @default(now())
  updatedAt                               DateTime                   @default(now()) @updatedAt
  from_Spot_organization                  Spot[]                     @relation("Spot_organization")
  from_ClassPack_organization             ClassPack[]                @relation("ClassPack_organization")
  from_CreditGrant_organization           CreditGrant[]              @relation("CreditGrant_organization")
  from_CreditEntry_organization           CreditEntry[]              @relation("CreditEntry_organization")
  from_Fee_organization                   Fee[]                      @relation("Fee_organization")
  from_PayRate_organization               PayRate[]                  @relation("PayRate_organization")
  from_PayLine_organization               PayLine[]                  @relation("PayLine_organization")
  from_PayrollRun_organization            PayrollRun[]               @relation("PayrollRun_organization")
  from_RetailItem_organization            RetailItem[]               @relation("RetailItem_organization")
  from_RetailSale_organization            RetailSale[]               @relation("RetailSale_organization")
  from_RetailReturn_organization          RetailReturn[]             @relation("RetailReturn_organization")
  from_RetailStockEntry_organization      RetailStockEntry[]         @relation("RetailStockEntry_organization")
  from_RetailClose_organization           RetailClose[]              @relation("RetailClose_organization")
  from_CounterPaymentAttempt_organization CounterPaymentAttempt[]    @relation("CounterPaymentAttempt_organization")
  from_StaffIntent_organization           StaffIntent[]              @relation("StaffIntent_organization")
  from_MemberImportRecord_organization    MemberImportRecord[]       @relation("MemberImportRecord_organization")
  from_TrainingPackage_organization       TrainingPackage[]          @relation("TrainingPackage_organization")
  from_TrainingCreditEntry_organization   TrainingCreditEntry[]      @relation("TrainingCreditEntry_organization")
  from_ContactMessage_organization        ContactMessage[]           @relation("ContactMessage_organization")
  from_GiftCard_organization              GiftCard[]                 @relation("GiftCard_organization")
  from_OperationalNotice_organization     OperationalNotice[]        @relation("OperationalNotice_organization")
  from_ParticipationPolicy_organization   ParticipationPolicy[]      @relation("ParticipationPolicy_organization")
  from_ParticipationEvidence_organization ParticipationEvidence[]    @relation("ParticipationEvidence_organization")
  from_OperationsCase_organization        OperationsCase[]           @relation("OperationsCase_organization")
  from_IntegrationCredential_organization IntegrationCredential[]    @relation("IntegrationCredential_organization")
}

model User {
  id                                    String                  @id @default(cuid())
  organization                          Organization?           @relation("User_organization", fields: [organizationId], references: [id])
  organizationId                        String?                 @map("organization")
  name                                  String                  @default("")
  email                                 String                  @unique @default("")
  password                              String
  role                                  Role?                   @relation("User_role", fields: [roleId], references: [id])
  roleId                                String?                 @map("role")
  membership                            Membership?             @relation("Membership_member")
  payments                              MembershipPayment[]     @relation("MembershipPayment_member")
  paymentSessions                       PaymentSession[]        @relation("PaymentSession_user")
  stripeCustomerId                      String                  @default("")
  phone                                 String                  @default("")
  emergencyContact                      String                  @default("")
  pendingEmail                          String                  @default("")
  pendingEmailTokenHash                 String                  @default("")
  pendingEmailRequestedAt               DateTime?
  onboardingStatus                      String                  @default("not_started")
  createdAt                             DateTime                @default(now())
  updatedAt                             DateTime                @default(now()) @updatedAt
  passwordResetToken                    String?
  passwordResetIssuedAt                 DateTime?
  passwordResetRedeemedAt               DateTime?
  from_CreditEntry_actor                CreditEntry[]           @relation("CreditEntry_actor")
  from_Fee_waivedBy                     Fee[]                   @relation("Fee_waivedBy")
  from_PayLine_createdBy                PayLine[]               @relation("PayLine_createdBy")
  from_PayrollRun_lockedBy              PayrollRun[]            @relation("PayrollRun_lockedBy")
  from_RetailSale_recordedBy            RetailSale[]            @relation("RetailSale_recordedBy")
  from_RetailReturn_recordedBy          RetailReturn[]          @relation("RetailReturn_recordedBy")
  from_RetailStockEntry_recordedBy      RetailStockEntry[]      @relation("RetailStockEntry_recordedBy")
  from_RetailClose_recordedBy           RetailClose[]           @relation("RetailClose_recordedBy")
  from_CounterPaymentAttempt_recordedBy CounterPaymentAttempt[] @relation("CounterPaymentAttempt_recordedBy")
  from_StaffIntent_actor                StaffIntent[]           @relation("StaffIntent_actor")
  from_TrainingPackage_recordedBy       TrainingPackage[]       @relation("TrainingPackage_recordedBy")
  from_TrainingCreditEntry_actor        TrainingCreditEntry[]   @relation("TrainingCreditEntry_actor")
  from_Member_user                      Member[]                @relation("Member_user")
  from_MembershipPayment_processedBy    MembershipPayment[]     @relation("MembershipPayment_processedBy")
  from_Payment_recordedBy               Payment[]               @relation("Payment_recordedBy")
  from_AttendanceRecord_markedBy        AttendanceRecord[]      @relation("AttendanceRecord_markedBy")
  from_Instructor_user                  Instructor[]            @relation("Instructor_user")
  from_ClassInstance_closedBy           ClassInstance[]         @relation("ClassInstance_closedBy")

  @@index([organizationId])
  @@index([roleId])
}

model Role {
  id                      String        @id @default(cuid())
  organization            Organization? @relation("Role_organization", fields: [organizationId], references: [id])
  organizationId          String?       @map("organization")
  name                    String        @default("")
  canCreateRecords        Boolean       @default(false)
  canManageAllRecords     Boolean       @default(false)
  canSeeOtherPeople       Boolean       @default(false)
  canEditOtherPeople      Boolean       @default(false)
  canManagePeople         Boolean       @default(false)
  canManageRoles          Boolean       @default(false)
  canAccessDashboard      Boolean       @default(false)
  canManageOnboarding     Boolean       @default(false)
  canManageSettings       Boolean       @default(false)
  canManageAppointments   Boolean       @default(false)
  canManageCheckIns       Boolean       @default(false)
  canManageFacilities     Boolean       @default(false)
  canManagePrograms       Boolean       @default(false)
  canManageCommunications Boolean       @default(false)
  canManageRetail         Boolean       @default(false)
  canManagePayroll        Boolean       @default(false)
  canViewReports          Boolean       @default(false)
  isInstructor            Boolean       @default(false)
  assignedTo              User[]        @relation("User_role")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @default(now()) @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Member {
  id                                String                  @id @default(cuid())
  organization                      Organization            @relation("Member_organization", fields: [organizationId], references: [id])
  organizationId                    String                  @map("organization")
  name                              String                  @default("")
  email                             String                  @unique @default("")
  phone                             String                  @default("")
  dateOfBirth                       DateTime?
  joinDate                          DateTime                @default(now())
  membershipTier                    MembershipTier?         @relation("Member_membershipTier", fields: [membershipTierId], references: [id])
  membershipTierId                  String?                 @map("membershipTier")
  emergencyContactName              String                  @default("")
  emergencyContactPhone             String                  @default("")
  healthNotes                       Json?                   @default("{\"conditions\":[],\"injuries\":[],\"notes\":\"\"}")
  profilePhoto_id                   String?
  profilePhoto_filesize             Int?
  profilePhoto_width                Int?
  profilePhoto_height               Int?
  profilePhoto_extension            String?
  status                            String                  @default("active")
  user                              User?                   @relation("Member_user", fields: [userId], references: [id])
  userId                            String?                 @map("user")
  bookings                          ClassBooking[]          @relation("ClassBooking_member")
  checkIns                          CheckIn[]               @relation("CheckIn_member")
  payments                          Payment[]               @relation("Payment_member")
  subscriptions                     Subscription[]          @relation("Subscription_member")
  appointments                      Appointment[]           @relation("Appointment_member")
  attendanceRecords                 AttendanceRecord[]      @relation("AttendanceRecord_member")
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @default(now()) @updatedAt
  from_CreditGrant_member           CreditGrant[]           @relation("CreditGrant_member")
  from_CreditEntry_member           CreditEntry[]           @relation("CreditEntry_member")
  from_Fee_member                   Fee[]                   @relation("Fee_member")
  from_MemberImportRecord_member    MemberImportRecord[]    @relation("MemberImportRecord_member")
  from_TrainingPackage_member       TrainingPackage[]       @relation("TrainingPackage_member")
  from_OperationalNotice_member     OperationalNotice[]     @relation("OperationalNotice_member")
  from_ParticipationEvidence_member ParticipationEvidence[] @relation("ParticipationEvidence_member")
  from_OperationsCase_member        OperationsCase[]        @relation("OperationsCase_member")
  from_PaymentMethod_member         PaymentMethod[]         @relation("PaymentMethod_member")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([membershipTierId])
  @@index([userId])
}

model MembershipTier {
  id                               String           @id @default(cuid())
  organization                     Organization     @relation("MembershipTier_organization", fields: [organizationId], references: [id])
  organizationId                   String           @map("organization")
  name                             String           @default("")
  description                      Json             @default("[{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]}]")
  monthlyPriceMinor                Int?
  annualPriceMinor                 Int?
  monthlyPrice                     Float
  annualPrice                      Float
  classCreditsPerMonth             Int              @default(0)
  guestPasses                      Int?             @default(0)
  personalTrainingSessions         Int?             @default(0)
  freezeAllowed                    Boolean          @default(false)
  contractLength                   Int?             @default(0)
  billingPeriod                    String           @default("month")
  maxBookingsPerDay                Int?             @default(0)
  maxBookingsPerMonth              Int?             @default(0)
  cancelNoticeDays                 Int?             @default(30)
  freezeMinDays                    Int?             @default(7)
  freezeMaxDays                    Int?             @default(30)
  freezeDaysPerYear                Int?             @default(30)
  freezeFee                        Int?             @default(0)
  advanceBookingDays               Int?             @default(14)
  offPeakOnly                      Boolean          @default(false)
  offPeakWindows                   Json?            @default("[{\"days\":[1,2,3,4,5],\"from\":\"09:00\",\"to\":\"16:00\"},{\"days\":[6,7],\"from\":\"12:00\",\"to\":\"21:00\"}]")
  rolloverPeriods                  Int?             @default(0)
  stripeMonthlyPriceId             String           @default("")
  stripeAnnualPriceId              String           @default("")
  stripeProductId                  String           @default("")
  price                            Int?
  billingInterval                  String?          @default("monthly")
  features                         Json?            @default("[]")
  maxClassBookings                 Int?             @default(0)
  hasGuestPrivileges               Boolean          @default(false)
  paymentSessions                  PaymentSession[] @relation("PaymentSession_membershipTier")
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @default(now()) @updatedAt
  from_Member_membershipTier       Member[]         @relation("Member_membershipTier")
  from_Membership_tier             Membership[]     @relation("Membership_tier")
  from_Subscription_membershipTier Subscription[]   @relation("Subscription_membershipTier")

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Membership {
  id                          String                     @id @default(cuid())
  organization                Organization               @relation("Membership_organization", fields: [organizationId], references: [id])
  organizationId              String                     @map("organization")
  member                      User?                      @relation("Membership_member", fields: [memberId], references: [id], onDelete: Restrict)
  memberId                    String?                    @unique @map("member")
  tier                        MembershipTier?            @relation("Membership_tier", fields: [tierId], references: [id])
  tierId                      String?                    @map("tier")
  status                      String                     @default("active")
  startDate                   DateTime
  billingCycle                String                     @default("monthly")
  agreementSnapshot           Json?                      @default("{}")
  agreementHistory            Json?                      @default("[]")
  creditPeriodStart           DateTime?
  creditPeriodEnd             DateTime?
  billingEventAt              DateTime?
  recoveryHistory             Json?                      @default("[]")
  nextBillingDate             DateTime?
  autoRenew                   Boolean                    @default(true)
  classCreditsRemaining       Int?                       @default(0)
  freezeStartDate             DateTime?
  freezeEndDate               DateTime?
  payments                    MembershipPayment[]        @relation("MembershipPayment_membership")
  stripeSubscriptionId        String?                    @unique
  cancelReason                String                     @default("")
  cancelledAt                 DateTime?
  billingAttempts             MembershipBillingAttempt[] @relation("MembershipBillingAttempt_membership")
  billingGeneration           Int                        @default(0)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @default(now()) @updatedAt
  from_CreditGrant_membership CreditGrant[]              @relation("CreditGrant_membership")

  @@index([organizationId])
  @@index([tierId])
}

model MembershipPayment {
  id                    String       @id @default(cuid())
  organization          Organization @relation("MembershipPayment_organization", fields: [organizationId], references: [id])
  organizationId        String       @map("organization")
  member                User?        @relation("MembershipPayment_member", fields: [memberId], references: [id], onDelete: Restrict)
  memberId              String?      @map("member")
  membership            Membership?  @relation("MembershipPayment_membership", fields: [membershipId], references: [id])
  membershipId          String?      @map("membership")
  amount                Int
  currencyCode          String       @default("USD")
  paymentType           String       @default("membership")
  status                String       @default("pending")
  paymentDate           DateTime     @default(now())
  paymentMethod         String?      @default("credit-card")
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeInvoiceId       String?      @unique
  receiptNumber         String       @default("")
  receiptUrl            String       @default("")
  description           String       @default("")
  notes                 String       @default("")
  isRecurring           Boolean      @default(false)
  refundedAt            DateTime?
  refundAmount          Int?
  refundReason          String       @default("")
  processedBy           User?        @relation("MembershipPayment_processedBy", fields: [processedById], references: [id])
  processedById         String?      @map("processedBy")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @default(now()) @updatedAt

  @@index([organizationId])
  @@index([memberId])
  @@index([membershipId])
  @@index([receiptNumber])
  @@index([processedById])
}

model Subscription {
  id                   String          @id @default(cuid())
  organization         Organization    @relation("Subscription_organization", fields: [organizationId], references: [id])
  organizationId       String          @map("organization")
  member               Member?         @relation("Subscription_member", fields: [memberId], references: [id], onDelete: Restrict)
  memberId             String?         @map("member")
  membershipTier       MembershipTier? @relation("Subscription_membershipTier", fields: [membershipTierId], references: [id])
  membershipTierId     String?         @map("membershipTier")
  status               String          @default("active")
  startDate            DateTime        @default(now())
  nextBillingDate      DateTime?
  cancelledAt          DateTime?
  pausedAt             DateTime?
  paymentMethod        PaymentMethod?  @relation("Subscription_paymentMethod", fields: [paymentMethodId], references: [id])
  paymentMethodId      String?         @map("paymentMethod")
  billingHistory       Payment[]       @relation("Payment_subscription")
  stripeSubscriptionId String          @unique @default("")
  stripeCustomerId     String          @default("")
  providerEventCreated Int             @default(0)
  providerEventId      String          @default("")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  @@index([organizationId])
  @@index([memberId])
  @@index([membershipTierId])
  @@index([paymentMethodId])
}

model Payment {
  id                       String           @id @default(cuid())
  organization             Organization     @relation("Payment_organization", fields: [organizationId], references: [id])
  organizationId           String           @map("organization")
  member                   Member?          @relation("Payment_member", fields: [memberId], references: [id], onDelete: Restrict)
  memberId                 String?          @map("member")
  subscription             Subscription?    @relation("Payment_subscription", fields: [subscriptionId], references: [id])
  subscriptionId           String?          @map("subscription")
  paymentProvider          PaymentProvider? @relation("Payment_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId        String?          @map("paymentProvider")
  paymentSession           PaymentSession?  @relation("Payment_paymentSession", fields: [paymentSessionId], references: [id])
  paymentSessionId         String?          @map("paymentSession")
  amount                   Int
  currencyCode             String           @default("USD")
  status                   String           @default("pending")
  purpose                  String?
  method                   String?          @default("stripe")
  recordedBy               User?            @relation("Payment_recordedBy", fields: [recordedById], references: [id])
  recordedById             String?          @map("recordedBy")
  paymentDate              DateTime         @default(now())
  metadata                 Json?            @default("{}")
  stripePaymentIntentId    String?
  stripeChargeId           String?
  stripeInvoiceId          String?          @unique
  receiptNumber            String           @default("")
  description              String           @default("")
  refundedAt               DateTime?
  refundAmount             Int?
  refundReason             String           @default("")
  refundLockUntil          DateTime?
  refundLockToken          String           @default("")
  refundAttempts           RefundAttempt[]  @relation("RefundAttempt_payment")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @default(now()) @updatedAt
  from_CreditGrant_payment CreditGrant[]    @relation("CreditGrant_payment")
  from_Fee_payment         Fee[]            @relation("Fee_payment")
  from_Appointment_payment Appointment[]    @relation("Appointment_payment")

  @@index([organizationId])
  @@index([memberId])
  @@index([subscriptionId])
  @@index([paymentProviderId])
  @@index([paymentSessionId])
  @@index([recordedById])
  @@index([receiptNumber])
}

model PaymentMethod {
  id                    String         @id @default(cuid())
  organization          Organization   @relation("PaymentMethod_organization", fields: [organizationId], references: [id])
  organizationId        String         @map("organization")
  member                Member?        @relation("PaymentMethod_member", fields: [memberId], references: [id])
  memberId              String?        @map("member")
  type                  String         @default("card")
  last4                 String         @default("")
  brand                 String         @default("")
  isDefault             Boolean        @default(false)
  stripePaymentMethodId String         @unique @default("")
  expiryMonth           String         @default("")
  expiryYear            String         @default("")
  subscriptions         Subscription[] @relation("Subscription_paymentMethod")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now()) @updatedAt

  @@index([organizationId])
  @@index([memberId])
}

model PaymentProvider {
  id                String           @id @default(cuid())
  organization      Organization     @relation("PaymentProvider_organization", fields: [organizationId], references: [id])
  organizationId    String           @map("organization")
  name              String           @default("")
  code              String           @default("")
  adapterKey        String           @default("")
  providerAccountId String?
  isInstalled       Boolean          @default(true)
  credentials       Json?            @default("{}")
  metadata          Json?            @default("{}")
  sessions          PaymentSession[] @relation("PaymentSession_paymentProvider")
  payments          Payment[]        @relation("Payment_paymentProvider")
  events            PaymentEvent[]   @relation("PaymentEvent_paymentProvider")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@unique([organizationId, code], map: "PaymentProvider_organization_code_key")
  @@index([organizationId])
  @@index([code])
  @@index([providerAccountId])
}

model PaymentSession {
  id                           String           @id @default(cuid())
  organization                 Organization     @relation("PaymentSession_organization", fields: [organizationId], references: [id])
  organizationId               String           @map("organization")
  user                         User?            @relation("PaymentSession_user", fields: [userId], references: [id], onDelete: Restrict)
  userId                       String?          @map("user")
  membershipTier               MembershipTier?  @relation("PaymentSession_membershipTier", fields: [membershipTierId], references: [id])
  membershipTierId             String?          @map("membershipTier")
  paymentProvider              PaymentProvider? @relation("PaymentSession_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId            String?          @map("paymentProvider")
  status                       String           @default("pending")
  billingCycle                 String
  amount                       Int
  currencyCode                 String           @default("USD")
  idempotencyKey               String           @default("")
  providerSessionId            String?          @unique
  providerCustomerId           String           @default("")
  providerSubscriptionId       String?          @unique
  checkoutUrl                  String?
  data                         Json?            @default("{}")
  expiresAt                    DateTime?
  completedAt                  DateTime?
  failedAt                     DateTime?
  cancelledAt                  DateTime?
  lastError                    String           @default("")
  provisioningLockedUntil      DateTime?
  payments                     Payment[]        @relation("Payment_paymentSession")
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @default(now()) @updatedAt
  from_GiftCard_paymentSession GiftCard[]       @relation("GiftCard_paymentSession")

  @@unique([organizationId, idempotencyKey], map: "PaymentSession_organization_idempotency_key")
  @@index([organizationId])
  @@index([userId])
  @@index([membershipTierId])
  @@index([paymentProviderId])
  @@index([idempotencyKey])
}

model PaymentEvent {
  id                String           @id @default(cuid())
  organization      Organization     @relation("PaymentEvent_organization", fields: [organizationId], references: [id])
  organizationId    String           @map("organization")
  providerEventId   String           @default("")
  eventType         String           @default("")
  attempts          Int?             @default(0)
  lockedUntil       DateTime?
  status            String           @default("processing")
  paymentProvider   PaymentProvider? @relation("PaymentEvent_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId String?          @map("paymentProvider")
  processedAt       DateTime?
  lastError         String           @default("")
  data              Json?            @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@unique([paymentProviderId, providerEventId], map: "PaymentEvent_provider_event_key")
  @@index([organizationId])
  @@index([paymentProviderId])
}

model CheckIn {
  id                  String       @id @default(cuid())
  organization        Organization @relation("CheckIn_organization", fields: [organizationId], references: [id])
  organizationId      String       @map("organization")
  member              Member?      @relation("CheckIn_member", fields: [memberId], references: [id], onDelete: Restrict)
  memberId            String?      @map("member")
  checkInTime         DateTime     @default(now())
  checkOutTime        DateTime?
  location            Location?    @relation("CheckIn_location", fields: [locationId], references: [id])
  locationId          String?      @map("location")
  method              String       @default("app")
  isGuest             Boolean      @default(false)
  guestName           String       @default("")
  membershipValidated Boolean      @default(false)
  validationNotes     String       @default("")
  openCheckInKey      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt

  @@unique([organizationId, memberId, openCheckInKey])
  @@index([organizationId])
  @@index([memberId])
  @@index([locationId])
}

model Location {
  id                                  String                   @id @default(cuid())
  organization                        Organization             @relation("Location_organization", fields: [organizationId], references: [id])
  organizationId                      String                   @map("organization")
  name                                String                   @default("")
  address                             String                   @default("")
  phone                               String                   @default("")
  isActive                            Boolean                  @default(true)
  resources                           Room[]                   @relation("Room_location")
  instructorAvailability              InstructorAvailability[] @relation("InstructorAvailability_location")
  appointments                        Appointment[]            @relation("Appointment_location")
  createdAt                           DateTime                 @default(now())
  updatedAt                           DateTime                 @default(now()) @updatedAt
